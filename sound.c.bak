#include <tamtypes.h>
#include <audsrv.h>
#include <stdio.h>
#include <malloc.h>
#include <string.h>
#include <stdint.h>

#include "utils.h"

void sound_init(void)
{
    audsrv_init();
}

void sound_stream_play_locking(char *filepath)
{
	if (!DEV_EXIST(filepath)) {return;}
	struct audsrv_fmt_t fmt;
	fmt.bits = 16;
	fmt.freq = 48000;  // or 22050, 48000 etc if supported
	fmt.channels = 2;

	if (audsrv_set_format(&fmt) < 0) {
		// error, use audsrv_format_ok() to check first if needed
	}
	audsrv_set_volume(MAX_VOLUME);  // 0x3fff max
		
	FILE *fp = fopen(filepath, "rb");  // or host: for pc test, or mass:/ for USB
	if (!fp) { /* error */ }

	char chunk[4096];  // tune size for your needs
	while (!feof(fp)) {
		int read = fread(chunk, 1, sizeof(chunk), fp);
		if (read <= 0) break;

		audsrv_wait_audio(read);        // wait for space (crucial!)
		audsrv_play_audio(chunk, read); // queue
	}

	audsrv_stop_audio();
	
	return;
}

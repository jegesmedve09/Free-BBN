import tkinter as tk
from PIL import Image, ImageTk

# ==========================
# Settings
# ==========================

FONT_SHEET = "font.png"

CHAR_WIDTH = 16
CHAR_HEIGHT = 32

SHEET_WIDTH = 512
SHEET_HEIGHT = 512

COLUMNS = SHEET_WIDTH // CHAR_WIDTH
ROWS = SHEET_HEIGHT // CHAR_HEIGHT
TOTAL_CHARS = COLUMNS * ROWS

SCALE = 2  # Preview scale (2 = double size)

# ==========================
# Character Mapping Table
# ==========================

CHAR_MAP = {
    "A": 1,
    "B": 2,
    "C": 3,
    "D": 4,
    "E": 5,
    "F": 6,
    "G": 7,
    "H": 8,
    "I": 9,
    "J": 10,
    "K": 11,
    "L": 12,
    "M": 13,
    "N": 14,
    "O": 15,
    "P": 16,
    "Q": 17,
    "R": 18,
    "S": 19,
    "T": 20,
    "U": 21,
    "V": 22,
    "W": 23,
    "X": 24,
    "Y": 25,
    "Z": 26,
    " ": 27,
    ">": 28,
    "<": 29,
    "$": 30,
    "€": 31,
    "_": 32,
    "a": 33,
    "b": 34,
    "c": 35,
    "d": 36,
    "e": 37,
    "f": 38,
    "g": 39,
    "h": 40,
    "i": 41,
    "j": 42,
    "k": 43,
    "l": 44,
    "m": 45,
    "n": 46,
    "o": 47,
    "p": 48,
    "q": 49,
    "r": 50,
    "s": 51,
    "t": 52,
    "u": 53,
    "v": 54,
    "w": 55,
    "x": 56,
    "y": 57,
    "z": 58,
    "|": 59,
    "%": 60,
    "\"": 61,
    ".": 62,
    ",": 63,
    ":": 64,
    "Б": 65,
    "Г": 66,
    "Д": 67,
    "Ё": 68,
    "Ж": 69,
    "З": 70,
    "И": 71,
    "Й": 72,
    "Л": 73,
    "П": 74,
    "Ф": 75,
    "Ц": 76,
    "Ч": 77,
    "Ш": 78,
    "Щ": 79,
    "Ъ": 80,
    "Ы": 81,
    "Э": 82,
    "Ю": 83,
    "Я": 84,
    "[": 85,
    "]": 86,
    "{": 87,
    "}": 88,
    "(": 89,
    ")": 90,
    "?": 91,
}

sheet = Image.open(FONT_SHEET).convert("RGBA")

def reload_image():
    global sheet
    sheet = Image.open(FONT_SHEET).convert("RGBA")


def get_char(index):
    """Returns one character image."""
    if index < 1 or index > TOTAL_CHARS:
        return Image.new("RGBA", (CHAR_WIDTH, CHAR_HEIGHT), (255, 0, 0, 120))

    index -= 1

    col = index % COLUMNS
    row = index // COLUMNS

    x = col * CHAR_WIDTH
    y = row * CHAR_HEIGHT

    return sheet.crop((x, y, x + CHAR_WIDTH, y + CHAR_HEIGHT))


def render():
    text = textbox.get("1.0", "end")

    if not text:
        canvas.delete("all")
        output_box.config(state="normal")
        output_box.delete("1.0", "end")
        output_box.config(state="disabled")
        return

    lines = []
    max_width = 1
    display_lines = []

    for line in text.splitlines():
        nums = []
        raw_parts = []

        for char in line:
            if char in CHAR_MAP:
                val = CHAR_MAP[char]
                if val > 0:
                    nums.append(val)
                    raw_parts.append(f"{val:03d}")
            else:
                pass

        if not nums and "," in line:
            for part in line.split(","):
                part = part.strip()
                if not part:
                    continue
                try:
                    val = int(part)
                    nums.append(val)
                    raw_parts.append(f"{val:03d}")
                except:
                    pass

        lines.append(nums if nums else [0])
        max_width = max(max_width, len(nums))
        display_lines.append(",".join(raw_parts))

    # Update the copy-friendly text widget and allow text selection
    output_box.config(state="normal")
    output_box.delete("1.0", "end")
    output_box.insert("1.0", "\n".join(display_lines))
    output_box.config(state="disabled")

    img = Image.new(
        "RGBA",
        (
            max_width * CHAR_WIDTH,
            max(len(lines), 1) * CHAR_HEIGHT
        ),
        (0, 0, 0, 0)
    )

    for y, nums in enumerate(lines):
        for x, n in enumerate(nums):
            if n > 0:
                img.paste(get_char(n), (x * CHAR_WIDTH, y * CHAR_HEIGHT))

    preview = img.resize(
        (img.width * SCALE, img.height * SCALE),
        Image.NEAREST
    )

    global preview_img
    preview_img = ImageTk.PhotoImage(preview)

    canvas.config(
        width=preview.width,
        height=preview.height
    )

    canvas.delete("all")
    canvas.create_image(0, 0, anchor="nw", image=preview_img)

    global last_image
    last_image = img


def update(event=None):
    reload_image()
    render()


def save(event=None):
    if last_image is not None:
        last_image.save("output.png")
        print("Saved output.png")


root = tk.Tk()
root.title("Bitmap Font Writer")

canvas = tk.Canvas(root, bg="black")
canvas.pack(padx=10, pady=10)

textbox = tk.Text(root, height=5, font=("Consolas", 12))
textbox.pack(fill="x", padx=10, pady=10)

# Changed from Label to a read-only Text widget so you can highlight and copy text normally
output_box = tk.Text(root, height=3, font=("Consolas", 12), bg="white", fg="black")
output_box.pack(fill="x", padx=10, pady=5)
output_box.config(state="disabled")

textbox.bind("<KeyRelease>", update)
root.bind("<Control-s>", save)

preview_img = None
last_image = None

textbox.insert("1.0", "WELCOME")
render()

root.mainloop()
